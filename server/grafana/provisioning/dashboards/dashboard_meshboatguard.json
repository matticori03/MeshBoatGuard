      "datasource": {
        "type": "influxdb",
        "uid": "influxdb_meshboatguard"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb_meshboatguard"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"meshboatguard_telemetry\")\n  |> filter(fn: (r) => r._field == \"alarm_active\")\n  |> drop(columns: [\"source\", \"msg_type\"])\n  |> last()",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "green",
                  "index": 0,
                  "text": "NORMAL (NO ALARMS)"
                },
                "1": {
                  "color": "red",
                  "index": 1,
                  "text": "ALARM TRIGGERED!"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
