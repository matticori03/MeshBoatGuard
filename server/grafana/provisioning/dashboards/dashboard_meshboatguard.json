      "id": 1,
      "title": "System State (Armed State)",
      "type": "stat",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb_meshboatguard"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb_meshboatguard"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"meshboatguard_telemetry\")\n  |> filter(fn: (r) => r._field == \"armed\")\n  |> drop(columns: [\"source\", \"msg_type\"])\n  |> last()",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "blue",
                  "index": 1,
                  "text": "DISARMED"
                },
                "1": {
                  "color": "green",
                  "index": 0,
                  "text": "ARMED"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
