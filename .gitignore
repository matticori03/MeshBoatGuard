# Node-RED: ignora lo stato runtime (incluso flows_cred.json con i token
# Telegram) ma versiona i flussi. Serve "data/*" e non "data/": git non
# re-include un file se la cartella padre e' esclusa.
server/nodered/data/*
!server/nodered/data/flows.json
.venv/
